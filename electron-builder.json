{
  "$schema": "node_modules/electron-builder/scheme.json",
  "appId": "com.luckyaluminium.erp",
  "productName": "Lucky Aluminium",
  "directories": {
    "output": "dist-electron2"
  },
  "files": [
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": ".output",
      "to": "app",
      "filter": ["**/*"]
    },
    {
      "from": "server/dist/udyana-server",
      "to": "backend",
      "filter": ["**/*"]
    }
  ],
  "electronDist": "node_modules/electron/dist",
  "win": {
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Lucky Aluminium"
  }
}
